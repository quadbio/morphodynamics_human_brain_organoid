seurat
head (seurat@meta.data, 5)
seurat <- NormalizeData (seurat, normalization.method = "LogNormalize", scale.factor = 10000)
head (seurat@meta.data, 5)
seurat <- FindVariableFeatures(seurat, nfeatures = 3000) %>%
ScaleData() %>%
RunPCA(npcs = 50)
seurat <- FindNeighbors(seurat, reduction = "pca", dims = 1:20) %>% FindClusters(resolution = 0.6)
seurat<-RunUMAP(seurat, reduction = "pca", dims = 1:22, min.dist =0.2, spread = 0.6)
plot1 <- UMAPPlot(seurat, cols = met.brewer("Johnson", n = 19), pt.size = 1, label = T) & NoAxes()
plot1
